# 悠米伴学 .gitignore
# 密钥与凭证
.env
*.pem
*.key
credentials*
.git-credentials

# 依赖
node_modules/
__pycache__/
*.pyc
.venv/

# 构建产物
.next/
out/
nginx-serve/_next/

# 临时文件
/tmp/

# 数据库文件（运行时生成）
*.db
*.tmp
.DS_Store
login-baseline*
*.db.bak*
backend/logs/

# 测试缓存
.pytest_cache/
tests/__pycache__/
.coverage
htmlcov/

# Playwright E2E 生成物
test-results/
playwright-report/

# TypeScript 增量编译
tsconfig.tsbuildinfo
